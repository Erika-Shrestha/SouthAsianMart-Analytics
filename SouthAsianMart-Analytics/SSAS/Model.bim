      {
        "name": "order_items",
        "columns": [
          {
            "name": "order_item_id",
            "dataType": "string",
            "sourceColumn": "order_item_id",
            "sourceProviderType": "Char"
          },
          {
            "name": "customer_key",
            "dataType": "int64",
            "sourceColumn": "customer_key",
            "sourceProviderType": "Integer"
          },
          {
            "name": "product_key",
            "dataType": "int64",
            "sourceColumn": "product_key",
            "sourceProviderType": "Integer"
          },
          {
            "name": "supplier_key",
            "dataType": "int64",
            "sourceColumn": "supplier_key",
            "sourceProviderType": "Integer"
          },
          {
            "name": "order_details_key",
            "dataType": "int64",
            "sourceColumn": "order_details_key",
            "sourceProviderType": "Integer"
          },
          {
            "name": "date_id",
            "dataType": "int64",
            "sourceColumn": "date_id",
            "sourceProviderType": "Integer"
          },
          {
            "name": "discount_pct",
            "dataType": "double",
            "sourceColumn": "discount_pct",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "quantity",
            "dataType": "int64",
            "sourceColumn": "quantity",
            "sourceProviderType": "UnsignedTinyInt"
          },
          {
            "name": "unit_price_at_sale",
            "dataType": "double",
            "sourceColumn": "unit_price_at_sale",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "line_total",
            "dataType": "double",
            "sourceColumn": "line_total",
            "sourceProviderType": "Numeric"
          },
          {
            "name": "review_score",
            "dataType": "int64",
            "sourceColumn": "review_score",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "review_length_chars",
            "dataType": "int64",
            "sourceColumn": "review_length_chars",
            "sourceProviderType": "SmallInt"
          },
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "sourceProviderType": "Char"
          }
        ],
        "partitions": [
          {
            "name": "order_items",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [fact].[order_items].*   FROM [fact].[order_items] ",
              "dataSource": "SqlServer DESKTOP-979JVN0ERIKASERVER SouthAsiaMart_DW"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": " SUM(order_items[line_total])",
            "formatString": "\"₹\" #,0.00;-\"₹\" #,0.00;\"₹\" #,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2145\" DisplayName=\"₹ Nepali (India)\" Symbol=\"₹\" PositivePattern=\"2\" NegativePattern=\"9\" /></Format>"
              }
            ]
          },
          {
            "name": "MOM% Revenue",
            "expression": [
              "",
              "VAR CurrentVal = [Total Revenue]",
              "VAR CurrentMonth = MAX('dates'[month_number])",
              "VAR CurrentYear = MAX('dates'[year])",
              "VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)",
              "VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)",
              "VAR PrevVal =",
              "    CALCULATE(",
              "        [Total Revenue],",
              "        FILTER(",
              "            ALL('dates'),",
              "            'dates'[month_number] = PrevMonth",
              "                && 'dates'[year] = PrevYear",
              "        )",
              "    )",
              "VAR Result = DIVIDE(CurrentVal - PrevVal, PrevVal, BLANK())",
              "RETURN",
              "    IF(",
              "        CurrentVal = 0 && PrevVal = 0,",
              "        BLANK(),",
              "        Result",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "CF MOM Revenue",
            "expression": [
              " ",
              "SWITCH(",
              "    TRUE(),",
              "    [MOM% Revenue] > 0, \"Green\",",
              "    [MOM% Revenue] < 0, \"Red\",",
              "    \"Grey\"",
              ")"
            ]
          },
          {
            "name": "Total Orders",
            "expression": [
              "",
              "DISTINCTCOUNT(order_items[order_id])"
            ]
          },
          {
            "name": "Total Discount",
            "expression": [
              "",
              "SUMX(",
              "    FILTER(order_items, order_items[discount_pct] <> 0),",
              "    order_items[discount_pct] * order_items[line_total]",
              ")"
            ],
            "formatString": "\"₹\" #,0.00;-\"₹\" #,0.00;\"₹\" #,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2145\" DisplayName=\"₹ Nepali (India)\" Symbol=\"₹\" PositivePattern=\"2\" NegativePattern=\"9\" /></Format>"
              }
            ]
          },
          {
            "name": "Average Order Value",
            "expression": [
              " ",
              "DIVIDE([Total Revenue], [Total Orders], 0)"
            ],
            "formatString": "\"₹\" #,0.00;-\"₹\" #,0.00;\"₹\" #,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2145\" DisplayName=\"₹ Nepali (India)\" Symbol=\"₹\" PositivePattern=\"2\" NegativePattern=\"9\" /></Format>"
              }
            ]
          },
          {
            "name": "MOM% Discount",
            "expression": [
              "",
              "VAR CurrentVal = [Total Discount]",
              "VAR CurrentMonth = MAX('dates'[month_number])",
              "VAR CurrentYear = MAX('dates'[year])",
              "VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)",
              "VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)",
              "VAR PrevVal =",
              "    CALCULATE(",
              "        [Total Discount],",
              "        FILTER(",
              "            ALL('dates'),",
              "            'dates'[month_number] = PrevMonth",
              "                && 'dates'[year] = PrevYear",
              "        )",
              "    )",
              "VAR Result = DIVIDE(CurrentVal - PrevVal, PrevVal, BLANK())",
              "RETURN",
              "    IF(",
              "        CurrentVal = 0 && PrevVal = 0,",
              "        BLANK(),",
              "        Result",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "MOM% Orders",
            "expression": [
              "",
              "VAR CurrentVal = [Total Orders]",
              "VAR CurrentMonth = MAX('dates'[month_number])",
              "VAR CurrentYear = MAX('dates'[year])",
              "VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)",
              "VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)",
              "VAR PrevVal =",
              "    CALCULATE(",
              "        [Total Orders],",
              "        FILTER(",
              "            ALL('dates'),",
              "            'dates'[month_number] = PrevMonth",
              "                && 'dates'[year] = PrevYear",
              "        )",
              "    )",
              "VAR Result = DIVIDE(CurrentVal - PrevVal, PrevVal, BLANK())",
              "RETURN",
              "    IF(",
              "        CurrentVal = 0 && PrevVal = 0,",
              "        BLANK(),",
              "        Result",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "MOM% AOV",
            "expression": [
              "",
              "VAR CurrentVal = [Average Order Value]",
              "VAR CurrentMonth = MAX('dates'[month_number])",
              "VAR CurrentYear = MAX('dates'[year])",
              "VAR PrevMonth = IF(CurrentMonth = 1, 12, CurrentMonth - 1)",
              "VAR PrevYear = IF(CurrentMonth = 1, CurrentYear - 1, CurrentYear)",
              "VAR PrevVal =",
              "    CALCULATE(",
              "        [Average Order Value],",
              "        FILTER(",
              "            ALL('dates'),",
              "            'dates'[month_number] = PrevMonth",
              "                && 'dates'[year] = PrevYear",
              "        )",
              "    )",
              "VAR Result = DIVIDE(CurrentVal - PrevVal, PrevVal, BLANK())",
              "RETURN",
              "    IF(",
              "        CurrentVal = 0 && PrevVal = 0,",
              "        BLANK(),",
              "        Result",
              "    )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "CF MOM Discount",
            "expression": [
              " ",
              "SWITCH(",
              "    TRUE(),",
              "    [MOM% Discount] > 0, \"Red\",",
              "    [MOM% Discount] < 0, \"Green\",",
              "    \"Grey\"",
              ")"
            ]
          },
          {
            "name": "CF MOM Orders",
            "expression": [
              " ",
              "SWITCH(",
              "    TRUE(),",
              "    [MOM% Orders] > 0, \"Green\",",
              "    [MOM% Orders] < 0, \"Red\",",
              "    \"Grey\"",
              ")"
            ]
          },
          {
            "name": "CF MOM AOV",
            "expression": [
              " ",
              "SWITCH(",
              "    TRUE(),",
              "    [MOM% AOV] > 0, \"Green\",",
              "    [MOM% AOV] < 0, \"Red\",",
              "    \"Grey\"",
              ")"
            ]
          },
          {
            "name": "Avg Review Score",
            "expression": " AVERAGE(order_items[review_score])"
          },
          {
            "name": "Order Status %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Orders],",
              "    CALCULATE([Total Orders], ALL(order_details[order_status]))",
              ") * 100"
            ]
          },
          {
            "name": "Payment Method %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Revenue],",
              "    CALCULATE([Total Revenue], ALL(order_details[payment_method]))",
              ") * 100"
            ]
          },
          {
            "name": "Inactive Customers",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(customers[customer_key]),",
              "    FILTER(",
              "        customers,",
              "        CALCULATE(COUNTROWS(order_items)) = 0",
              "    )",
              ")"
            ]
          },
          {
            "name": "Active Customers",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT(customers[customer_key]),",
              "    FILTER(",
              "        customers,",
              "        CALCULATE(COUNTROWS(order_items)) > 0",
              "    )",
              ")"
            ]
          }
        ],
        "annotations": [
          {
            "name": "_TM_ExtProp_QueryDefinition",
            "value": " \t\t\t\tSELECT [fact].[order_items].*   FROM [fact].[order_items] "
          },
          {
            "name": "_TM_ExtProp_DbTableName",
            "value": "order_items"
          },
          {
            "name": "_TM_ExtProp_DbSchemaName",
            "value": "fact"
          }
        ]
      }
    ],
