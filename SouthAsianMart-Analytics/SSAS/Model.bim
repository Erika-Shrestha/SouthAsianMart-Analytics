          }
        ],
        "partitions": [
          {
            "name": "customers",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [dim].[customers].*   FROM [dim].[customers] ",
              "dataSource": "SqlServer DESKTOP-979JVN0ERIKASERVER SouthAsiaMart_DW"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Customers",
            "expression": [
              " ",
              "DISTINCTCOUNT(customers[customer_id])"
            ]
          },
          {
            "name": "Repeated Customer Revenue",
            "expression": [
              " ",
              "CALCULATE(",
              "    [Total Revenue],",
              "    FILTER(",
              "        customers,",
              "        CALCULATE(DISTINCTCOUNT(order_items[order_id])) > 1",
              "    )",
              ")"
            ],
            "formatString": "\"₹\" #,0.00;-\"₹\" #,0.00;\"₹\" #,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2145\" DisplayName=\"₹ Nepali (India)\" Symbol=\"₹\" PositivePattern=\"2\" NegativePattern=\"9\" /></Format>"
              }
            ]
          },
          {
            "name": "New Customer Revenue",
            "expression": [
              " ",
              "CALCULATE(",
              "    [Total Revenue],",
              "    FILTER(",
              "        customers,",
              "        CALCULATE(DISTINCTCOUNT(order_items[order_id])) = 1",
              "    )",
              ")"
            ],
            "formatString": "\"₹\" #,0.00;-\"₹\" #,0.00;\"₹\" #,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"2145\" DisplayName=\"₹ Nepali (India)\" Symbol=\"₹\" PositivePattern=\"2\" NegativePattern=\"9\" /></Format>"
              }
            ]
          },
          {
            "name": "High Value Customer Revenue %",
            "expression": [
              " ",
              "DIVIDE(",
              "    CALCULATE(",
              "        [Total Revenue],",
              "        customers[customer_segment] IN {\"Premium\", \"VIP\"}",
              "    ),",
              "    CALCULATE([Total Revenue], ALL(customers[customer_segment]))",
              ")"
            ]
          },
          {
            "name": "Repeat Purchase Rate",
            "expression": [
              " ",
              "DIVIDE(",
              "    CALCULATE(",
              "        DISTINCTCOUNT(order_items[customer_key]),",
              "        FILTER(",
              "            customers,",
              "            CALCULATE(DISTINCTCOUNT(order_items[order_id])) > 1",
              "        )",
              "    ),",
              "    [Total Customers]",
              ")"
            ]
          }
        ],
        "hierarchies": [
          {
            "name": "Customer Hierarchy",
            "levels": [
              {
                "name": "customer_segment",
                "ordinal": 0,
                "column": "customer_segment"
              },
              {
                "name": "age_group",
